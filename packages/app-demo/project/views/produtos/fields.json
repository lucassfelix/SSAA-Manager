{
    "$schema": "../../../../../schemas/fields.schema.json",
    "comment": "Generated from listview.json and form.json",
    "name": "produtos",
    "language": "ptBR",
    "fields": {
        "id": {
            "colStyles": "tabular",
            "header": "Nº",
            "colWidth": 60,
            "dataType": "string",
            "fieldWidth": 60,
            "footerIcon": "sum",
            "label": "Nº",
            "mask": { "pattern": "0000", "digits": 4 },
            "readOnly": true
        },
        "sku": {
            "colStyles": "sm",
            "header": "SKU",
            "colWidth": 140,
            "dataType": "string",
            "fieldWidth": 180,
            "label": "SKU",
            "placeholder": "Código SKU",
            "required": true
        },
        "descricao": {
            "header": "Descrição",
            "dataType": "string",
            "fieldWidth": "100%",
            "filterPlaceholder": "Descrição parcial ou completa",
            "filterWidth": "50%",
            "footer": "{count} produtos",
            "label": "Descrição",
            "placeholder": "Descrição do produto",
            "render": { "layout": "link", "op": "detail" },
            "required": true
        },
        "data_entrada": {
            "colStyles": "sm",
            "header": "Entrada",
            "colWidth": 120,
            "dataType": "date",
            "fieldWidth": 140,
            "label": "Data de entrada",
            "placeholder": "Selecione",
            "render": { "layout": "date", "format": "relative" },
            "required": true
        },
        "estoque": {
            "colTextAlign": "right",
            "header": "Estoque",
            "colWidth": 80,
            "dataType": "integer",
            "fieldWidth": 120,
            "label": "Estoque",
            "placeholder": "0",
            "required": true
        },
        "valor": {
            "colTextAlign": "right",
            "header": "Valor (R$)",
            "colWidth": 100,
            "dataType": "decimal",
            "fieldWidth": 120,
            "footer": "{sum}",
            "label": "Valor (R$)",
            "placeholder": "0,00",
            "render": { "layout": "decimal" },
            "required": true
        },
        "commands": {
            "headerIcon": "tools",
            "colTextAlign": "center",
            "colWidth": 60,
            "render": { "layout": "actions" }
        }
    }
}
