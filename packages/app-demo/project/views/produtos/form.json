{
    "$schema": "../../../../../schemas/form.schema.json",
    "name": "produtos",
    "language": "ptBR",
    "layout": {
        "sections": [
            {
                "initialState": "hidden",
                "columns": [
                    [
                        "id",
                        [ "data_entrada", "estoque" ]
                    ],
                    [
                        "descricao",
                        [ "sku", "valor" ]

                    ]
                ]
            }
        ]
    },
    "edit": {
        "title": "{name}",
        "toolbar": [ "previous", "next", { "type": "spacer" }, "send", "cancel" ]
    },
    "add": {
        "title": "Novo produto",
        "toolbar": [ "send", "cancel" ]
    },
    "detail": {
        "title": "{name}",
        "toolbar": [ "edit", "close" ]
    }
}