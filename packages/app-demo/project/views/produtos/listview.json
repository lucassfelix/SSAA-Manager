{
    "$schema": "../../../../../schemas/listview.schema.json",
    "name": "produtos",
    "type": "listView",
    "language": "ptBR",
    "config": {
        "header": true,
        "footer": true,
        "idAccessor": "id",
        "nameAccessor": "descricao",
        "rowClassAccessor": "none"
    },
    "columns": [
        "id",
        "sku",
        "descricao",
        "data_entrada",
        "estoque",
        "valor",
		"actions"
    ],
    "actions": [ "record_edit", "record_delete" ],
    "toolbar": [
        { "type": "title", "text": "Produtos" },
        "add",
        "separator",
        "search",
        "filterPanel",
        "separator",
        "listViewMore"
    ],
    "filterPanel": {
        "layout": { "header": [ "descricao", "sku" ] },
        "toolbar": [ "filter", "filterMore" ]
    }
}