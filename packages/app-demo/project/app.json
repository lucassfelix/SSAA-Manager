{
	"$schema": "../../../schemas/app.schema.json",
	"version": "0.2.0",
	"language": "pt-br",
	"comments": "Demo: configuração de projeto",
	"projectId": "neofront-demo-app",
	"strings": {
		"appTitle": "{pageName} | NeoFront {version}",
		"appVersion": "0.17.2"
	},
	"errorStrings": {
		"noRecordsText": "Sem itens a exibir"
	},
	"paths": {
		"images": "images/"
	},
	"shell": {
		"header": {
			"fullWidth": true,
			"height": 80,
			"bordered": true,
			"items": [ "collapseToggle", "logo", "spacer", "mainTitle", "spacer", "themeSwitch" ]
		},
		"navbar": {
			"width": 280,
			"collapsible": true,
			"collapsedWidth": 72,
			"bordered": true,
			"icons": true,
			"footer": false,
			"items": [ "mainMenu" ]
		}
	},
	"menu": {
		"openSubmenusOnHover": false,
		"submenuOffset": 12,
		"items": {
			"gap": 2,
			"radius": 8,
			"labelSize": "1rem",
			"labelWeight": 600,
			"subtitleSize": "0.65rem",
			"subtitleWeight": 700,
			"subtitleUppercase": true,
			"descriptionSize": "0.85rem",
			"descriptionWeight": 600,
			"iconFilled": false,
			"iconSize": 26,
			"iconStroke": 1.5,
			"arrowIcon": "chevronRight",
			"arrowStroke": 2,
			"arrowSize": 20
		},
		"submenuItems": {
			"gap": 6,
			"labelSize": "0.9rem",
			"labelWeight": 400
		}
	},
	"toolbars": {
		"horizontalPadding": 24,
		"verticalPadding": 6,
		"gap": 16,
		"align": "left",
		"upperBorder": false,
		"iconButtons": {
			"rotateSelected": true,
			"size": 36,
			"radius": 8,
			"outlineStroke": 1.5,
			"filled": false,
			"selectedVariant": "filled",
			"regularVariant": "subtle",
			"iconSize": 24,
			"iconStroke": 2
		},
		"textButtons": {
			"size": "sm",
			"radius": 6,
			"defaultVariant": "filled",
			"regularVariant": "light"
		},
		"titles": {
			"size": 20,
			"fontWeight": 600,
			"width": 120
		}
	},
	"controls": {
		"mainTitle": {
			"label": "Aplicação de Exemplo NeoFront"
		},
		"collapseToggle": {
			"rotateIcon": true,
			"tipCollapse": "Fechar a barra lateral",
			"tipExpand": "Abrir a barra lateral"
		},
		"logo": {
			"collapsedHeight": 52,
			"expandedHeight": 52,
			"altText": "Logotipo Hypervisual",
			"link": "/"
		},
		"themeSwitch": {
			"type": "iconButton",
			"tipLight": "Mudar para o tema claro",
			"tipDark": "Mudar para o tema escuro"
		},
		"userMenu": {
			"type": "iconButton",
			"name": "userSettings",
			"icon": "manage_accounts",
			"action": "openUserSettings",
			"items": [ ]
		},
		"separator": {
			"type": "separator"
		},
		"add": {
			"type": "iconButton",
			"tip": "Adicionar {singular}",
			"icon": "add",
			"action": "add"
		},
		"search": {
			"type": "iconButton",
			"tip": "Pesquisar {plural}",
			"icon": "search",
			"action": "search"
		},
		"filterPanel": {
			"type": "iconButton",
			"toggle": true,
			"tip": "Abrir painel de pesquisa",
			"selectedTip": "Fechar painel de pesquisa",
			"icon": "filter",
			"action": "toggleFilterPanel"
		},
		"send": {
			"type": "textButton",
			"label": "Enviar",
			"action": "send",
			"default": true
		},
		"cancel": {
			"type": "textButton",
			"label": "Cancelar",
			"action": "cancel"
		},
		"filter": {
			"type": "textButton",
			"label": "Pesquisar",
			"action": "filter",
			"default": true
		},
		"listViewMore": {
			"type": "iconButton",
			"tip": "Mais ações",
			"icon": "moreVertical",
			"items": [
				{ "label": "Exportar para planilha", "action": "exportCSV" },
				{ "label": "Exportar PDF", "action": "exportPDF" },
				{ "type": "separator" },
				{ "label": "Imprimir listagem", "action": "printRecords" }
			]
		},
		"filterMore": {
			"type": "iconButton",
			"icon": "moreVertical",
			"tip": "Mais opções",
			"items": [
				{ "label": "Salvar pesquisa", "action": "saveFilter" },
				{ "label": "Carregar pesquisa", "action": "loadFilter" },
				{ "type": "separator" },
				{ "label": "Fechar painel", "action": "closeFilterPanel" },
				{ "label": "Limpar filtros", "action": "clearForm" }
			]
		}
	},
	"listViews": {
		"defaultList": "usuarios",
		"defaultPageSize": 10,
		"table": {
			"striped": true,
			"bordered": true,
			"rowBorders": false,
			"colBorders": false,
			"borderRadius": "sm",
			"horizontalSpacing": 10,
			"verticalSpacing": 8,
			"headerHeight": 20,
			"shadow": "xs",
			"emphasis": {
				"textLight": "var(--mantine-color-green-9)",
				"textDark": "var(--mantine-color-green-3)",
				"backgroundLight": "#68b86820",
				"backgroundDark": "#4d6d4d30"
			},
			"wrappers": {
				"size": "md",
				"statusWidth": 90,
				"booleanWidth": 50
			},
			"booleanIcons": {
				"size": 26,
				"stroke": 1,
				"trueIcon": "circleCheck",
				"falseIcon": "squareX",
				"trueColorLight": "var(--mantine-color-teal-6)",
				"trueColorDark": "var(--mantine-color-green-4)",
				"falseColorLight": "var(--mantine-color-red-6)",
				"falseColorDark": "var(--mantine-color-red-4)"
			}
		},
		"toolbar": {
			"horizontalPadding": 24,
			"verticalPadding": 6,
			"gap": 16,
			"align": "left",
			"iconButton": {
				"rotateSelected": true,
				"size": 36,
				"radius": 8,
				"stroke": 1.5,
				"filled": false,
				"icon": {
					"size": 24,
					"stroke": 2
				}
			},
			"textButton": {
				"size": "sm",
				"radius": 6
			},
			"text": {
				"size": 20,
				"fontWeight": 600,
				"width": 120
			}
		},
		"buttons": {
			"separator": {
				"type": "separator"
			},
			"add": {
				"type": "iconButton",
				"tip": "Adicionar {singular}",
				"icon": "add",
				"action": "add"
			},
			"search": {
				"type": "iconButton",
				"tip": "Pesquisar {plural}",
				"icon": "search",
				"action": "search"
			},
			"filter": {
				"type": "iconButton",
				"toggle": true,
				"tip": "Abrir painel de pesquisa",
				"selectedTip": "Fechar painel de pesquisa",
				"icon": "filter",
				"action": "toggleFilterPanel"
			},
			"more": {
				"type": "iconButton",
				"tip": "Mais ações",
				"icon": "moreVertical",
				"items": [
					{
						"name": "exportCSV",
						"label": "Exportar para planilha",
						"action": "exportCSV"
					},
					{
						"name": "exportPDF",
						"label": "Exportar PDF",
						"action": "exportPDF"
					},
					{
						"type": "separator"
					},
					{
						"name": "print",
						"label": "Imprimir listagem",
						"action": "printRecords"
					}
				]
			}
		},
		"filterPanel": {
			"verticalPadding": 12,
			"transitionDuration": 200,
			"toolbar": {
				"horizontalPadding": 0,
				"verticalPadding": 0,
				"gap": 16,
				"align": "right",
				"upperBorder": false
			}
		},
		"pageSizes": [
			5,
			10,
			20,
			50,
			100
		],
		"pagination": {
			"showFirstLast": false,
			"showPageSizeSelector": true,
			"showInfo": true
		},
		"infiniteScroll": {
			"enabled": false,
			"threshold": 300
		}
	},
	"forms": {
		"fieldSize": "sm",
		"verticalGap": "xl",
		"fullHeight": true,
		"clearSelectionValue": "__clear_selection__",
		"selectionCheck": false,
		"checkboxTopPadding": 36,
		"outlinedSections": false,
		"toolbar": {
			"horizontalPadding": 24,
			"verticalPadding": 6,
			"gap": 16,
			"align": "right",
			"upperBorder": true,
			"iconButton": {
				"rotateSelected": true,
				"size": 36,
				"radius": 8,
				"stroke": 1.5,
				"filled": false,
				"selectedVariant": "filled",
				"regularVariant": "subtle",
				"icon": {
					"size": 24,
					"stroke": 2
				}
			},
			"textButton": {
				"size": "sm",
				"radius": 6,
				"defaultVariant": "filled",
				"regularVariant": "light"
			},
			"text": {
				"size": 20,
				"fontWeight": 600,
				"width": 120
			}
		},
		"buttons": {
			"separator": {
				"type": "separator"
			},
			"send": {
				"type": "textButton",
				"label": "Enviar",
				"action": "send",
				"default": true
			},
			"cancel": {
				"type": "textButton",
				"label": "Cancelar",
				"action": "cancel"
			},
			"filter": {
				"type": "textButton",
				"label": "Pesquisar",
				"action": "filter",
				"default": true
			},
			"more": {
				"type": "iconButton",
				"icon": "moreVertical",
				"tip": "Mais opções",
				"items": [
					{
						"label": "Salvar pesquisa",
						"action": "saveFilter"
					},
					{
						"label": "Carregar pesquisa",
						"action": "loadFilter"
					},
					{
						"type": "separator"
					},
					{
						"label": "Fechar painel",
						"action": "closeFilterPanel"
					},
					{
						"label": "Limpar filtros",
						"action": "clearForm"
					}
				]
			}
		}
	},
	"theme": {
		"defaultUIScale": 100,
		"iconFamily": "tabler",
		"typography": {
			"mainFamily": null,
			"headingsFamily": null
		},
		"modes": {
			"light": {
				"expandedLogo": "logo-horiz-light.svg",
				"collapsedLogo": "logo-symbol.svg"
			},
			"dark": {
				"expandedLogo": "logo-horiz-dark.svg",
				"collapsedLogo": "logo-symbol.svg"
			}
		}
	}
}