{
	"$schema": "../../../schemas/app.schema.json",
	"version": "0.3.0",
	"language": "pt-br",
	"comments": "Demo: configuração da aplicação",
	"projectId": "neofront-demo-app",
	"strings": {
		"appVersion": "0.17.2",
		"appTitle": "{pageName} | NeoFront {version}"
	},
	"errorStrings": {
		"noRecordsText": "Não há itens a serem exibidos"
	},
	"errorImages": {
		"noViewType": "fruit_basket",
		"viewMissing": "beach_house",
		"formLayoutMissing": "shipwreck_survivor",
		"formConfigMissing": "octopus",
		"formMissing": "forest"
	},
	"paths": {
		"images": "images/"
	},
	"shell": {
		"header": {
			"fullWidth": true,
			"height": 80,
			"bordered": true,
			"items": [ "collapseToggle", "logo", "spacer", "mainTitle", "spacer", "userToolbar" ]
		},
		"navbar": {
			"width": 280,
			"collapsible": true,
			"collapsedWidth": 72,
			"bordered": true,
			"icons": true,
			"footer": false,
			"items": [ "mainMenu" ]
		},
		"userToolbar": [ { "type": "text", "text": "Usuário" }, "userMenu" ]
	},
	"menu": {
		"openSubmenusOnHover": false,
		"submenuOffset": 12,
		"items": {
			"gap": 2,
			"radius": 8,
			"labelSize": "1rem",
			"labelWeight": 600,
			"subtitleSize": "0.8rem",
			"subtitleWeight": null,
			"subtitleUppercase": true,
			"descriptionSize": "0.85rem",
			"descriptionWeight": 600,
			"iconFilled": false,
			"iconSize": 26,
			"iconStroke": 1.5,
			"arrowIcon": "chevronRight",
			"arrowStroke": 2,
			"arrowSize": 20
		},
		"submenuItems": {
			"gap": 6,
			"labelSize": "0.9rem",
			"labelWeight": 400,
			"subtitleSize": "0.65rem"
		}
	},
	"toolbars": {
		"horizontalPadding": 24,
		"verticalPadding": 6,
		"gap": 16,
		"align": "left",
		"upperBorder": false,
		"iconButtons": {
			"rotateSelected": true,
			"size": 36,
			"radius": 8,
			"filled": false,
			"selectedVariant": "filled",
			"regularVariant": "subtle",
			"iconSize": 24,
			"iconStroke": 2,
			"selectedIcon": "check"
		},
		"textButtons": {
			"size": "sm",
			"radius": 6,
			"defaultVariant": "filled",
			"regularVariant": "light"
		},
		"texts": {
			"fontWeight": 600
		},
		"titles": {
			"size": 20,
			"fontWeight": 600,
			"width": 120
		}
	},
	"topControls": {
		"mainTitle": {
			"label": "Aplicação de Exemplo NeoFront"
		},
		"collapseToggle": {
			"rotateIcon": true,
			"tipCollapse": "Fechar a barra lateral",
			"tipExpand": "Abrir a barra lateral"
		},
		"themeSwitch": {
			"type": "iconButton",
			"tipLight": "Mudar para o tema claro",
			"tipDark": "Mudar para o tema escuro"
		},
		"logo": {
			"collapsedHeight": 52,
			"expandedHeight": 52,
			"altText": "Logotipo Hypervisual",
			"link": "/"
		}
	},
	"controls": {
		"userMenu": {
			"type": "iconButton",
			"name": "userSettings",
			"icon": "userSettings",
			"tip": "Opções do usuário",
			"items": [
				{ "label": "Tema claro", "action": "lightMode", "selectable": true },
				{ "label": "Tema escuro", "action": "darkMode", "selectable": true },
				{ "type": "separator" },
				{ "label": "Sair", "action": "logout" }
			]
		},
		"separator": {
			"type": "separator"
		},
		"add": {
			"type": "iconButton",
			"tip": "Adicionar {singular}",
			"icon": "add",
			"action": "add"
		},
		"search": {
			"type": "iconButton",
			"tip": "Pesquisar {plural}",
			"icon": "search",
			"action": "search"
		},
		"record_detail": {
			"type": "iconButton",
			"tip": "Ver detalhes do {singular}",
			"icon": "view",
			"action": "detail"
		},
		"record_edit": {
			"type": "iconButton",
			"tip": "Editar {singular}",
			"icon": "edit",
			"action": "edit"
		},
		"record_delete": {
			"type": "iconButton",
			"tip": "Excluir {singular}",
			"icon": "trash",
			"action": "delete",
			"class": "warning"
		},
		"send": {
			"type": "textButton",
			"label": "Enviar",
			"action": "send",
			"default": true
		},
		"cancel": {
			"type": "textButton",
			"label": "Cancelar",
			"action": "cancel"
		},
		"close": {
			"type": "textButton",
			"label": "Fechar",
			"action": "cancel",
			"default": true
		},
		"edit": {
			"type": "textButton",
			"label": "Editar",
			"action": "edit"
		},
		"previous": {
			"type": "iconButton",
			"icon": "arrowLeft",
			"tip": "Anterior",
			"action": "previous"
		},
		"next": {
			"type": "iconButton",
			"icon": "arrowRight",
			"tip": "Próximo",
			"action": "next"
		},
		"listViewMore": {
			"type": "iconButton",
			"tip": "Mais ações",
			"icon": "moreVertical",
			"items": [
				{ "label": "Exportar para planilha", "action": "exportCSV" },
				{ "label": "Exportar PDF", "action": "exportPDF" },
				{ "type": "separator" },
				{ "label": "Imprimir listagem", "action": "printRecords" }
			]
		},
		"filterPanel": {
			"type": "iconButton",
			"toggle": true,
			"tip": "Abrir painel de pesquisa",
			"selectedTip": "Fechar painel de pesquisa",
			"icon": "filter",
			"action": "toggleFilterPanel"
		},
		"filter": {
			"type": "textButton",
			"label": "Pesquisar",
			"action": "filter",
			"default": true
		},
		"filterMore": {
			"type": "iconButton",
			"icon": "moreVertical",
			"tip": "Mais opções",
			"items": [
				{ "label": "Salvar pesquisa", "action": "saveFilter" },
				{ "label": "Carregar pesquisa", "action": "loadFilter" },
				{ "type": "separator" },
				{ "label": "Fechar painel", "action": "closeFilterPanel" },
				{ "label": "Limpar filtros", "action": "clearForm" }
			]
		}
	},
	"listViews": {
		"defaultList": "usuarios",
		"table": {
			"striped": true,
			"bordered": true,
			"rowBorders": false,
			"colBorders": false,
			"borderRadius": "sm",
			"horizontalSpacing": 10,
			"verticalSpacing": 8,
			"headerHeight": 20,
			"shadow": "xs",
			"wrapperSize": "md",
			"wrapperBooleanWidth": 50,
			"booleanIconsSize": 26,
			"booleanIconsStroke": 1.5,
			"footerIconsSize": 22,
			"footerIconsStroke": 2,
			"headerIconsSize": 18,
			"headerIconsStroke": 2.5,
			"trueIcon": "circleCheck",
			"falseIcon": "squareX",
			"imageRadius": "sm"
		},
		"filterPanel": {
			"labelPosition": "top",
			"verticalPadding": 12,
			"transitionDuration": 200
		},
		"filterToolbar": {
			"horizontalPadding": 0,
			"verticalPadding": 0,
			"align": "right",
			"position": "right"
		},
		"actionToolbar": {
			"horizontalPadding": 12,
			"verticalPadding": 0,
			"gap": 4,
			"align": "center",
			"iconButtons": {
				"iconSize": 22
			}
		},
		"pagination": {
			"defaultPageSize": 10,
			"pageSizes": [ 5, 10, 20, 50, 100 ],
			"showFirstLast": false,
			"showPageSizeSelector": true,
			"showTotalItems": false
		},
		"infiniteScroll": {
			"enabled": false,
			"threshold": 300
		}
	},
	"forms": {
		"fieldSize": "sm",
		"verticalGap": "xl",
		"fullHeight": true,
		"clearSelectionValue": "__clear_selection__",
		"selectionCheck": false,
		"checkboxTopPadding": 36,
		"outlinedSections": false,
		"imageRadius": "sm",
		"imageHeight": 80,
		"toolbar": {
			"align": "right",
			"upperBorder": true,
			"position": "bottom",
			"horizontalPadding": 0
		}
	},
	"theme": {
		"defaultUIScale": 100,
		"iconFamily": "tabler",
		"mainFontFamily": null,
		"headingsFontFamily": null,
		"lightMode": {
			"expandedLogo": "logo-horiz-light.svg",
			"collapsedLogo": "logo-symbol.svg"
		},
		"darkMode": {
			"expandedLogo": "logo-horiz-dark.svg",
			"collapsedLogo": "logo-symbol.svg"
		}
	}
}