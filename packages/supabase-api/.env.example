# Supabase → Project Settings → Database → Database password (NOT the same as SESSION_SECRET).

# --- Local: npm run supabase-api on Windows/Mac (direct) ---
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.[ref].supabase.co:5432/postgres

# --- Docker / cloud: copy the full "Session pooler" URI from the dashboard (do not guess aws-0 vs aws-1) ---
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-DATABASE-PASSWORD]@[pooler-host-from-dashboard]:6543/postgres

SESSION_SECRET=replace_with_a_long_random_secret_at_least_16_chars

SUPABASE_URL=https://[ref].supabase.co

COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

CORS_ORIGIN=http://localhost:5173

# AUTH_DISABLED=true

PORT=3101
