{
    "$schema": "../../../../../schemas/form.schema.json",
    "name": "projetos",
    "language": "ptBR",
    "layout": {
        "sections": [
            {
                "initialState": "noheader",
                "columns": [
                    [
                        "nome",
                        [ "paciente_id", "usuario_id" ]
                    ],
                    [
                        [ "data_criacao", "ultima_edicao" ],
                        [ "instituicao_id", "status" ]
                    ]
                ]
            }
        ]
    },
    "edit": {
        "title": "{name}",
        "toolbar": [ "send", "cancel" ]
    },
    "add": {
        "title": "Novo produto",
        "toolbar": [ "send", "cancel" ]
    },
    "detail": {
        "title": "{name}",
        "toolbar": [ "close" ]
    }
}