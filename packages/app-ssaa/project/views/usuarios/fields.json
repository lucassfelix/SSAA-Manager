            "placeholder": "Nome abreviado",
            "required": true
        },
        "username": {
            "header": "Usuário",
            "colWidth": 140,
            "dataType": "string",
            "fieldWidth": 200,
            "label": "Nome de usuário",
            "placeholder": "Username",
            "required": true
        },
        "senha": {
            "header": "Senha",
            "colWidth": 140,
            "dataType": "password",
            "fieldWidth": 240,
            "label": "Senha",
            "readOnly": true
        },
        "email": {
            "header": "E-mail",
            "colWidth": 220,
            "dataType": "string",
            "fieldWidth": "100%",
