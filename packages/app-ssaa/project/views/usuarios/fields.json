        "data_criacao": {
            "colStyles": "sm",
            "colWidth": 140,
            "dataType": "date",
            "defaultValue": "now",
            "fieldWidth": 140,
            "header": "Criado",
            "label": "Cadastrado em",
            "placeholder": "Selecione",
            "readOnly": true,
            "render": { "layout": "date", "format": "relative" },
            "required": true
