{
    "$schema": "../../../../../schemas/form.schema.json",
    "comment": "Generated manually",
    "name": "usuarios",
    "language": "ptBR",
    "layout": {
        "tabs": [
            {
                "label": "Cadastro",
                "name": "cadastro",
                "sections": [
                    {
                        "initialState": "noheader",
                        "columns": [
                            [
                                [ "username" ],
                                "nome_completo",
                                "email"
                            ],
                            [
                                "clinica_id",
                                [ "data_criacao", "data_expiracao" ],
                                [ "status", "senha" ]
                            ]
                        ]
                    }
                ]
            },
            {
                "label": "Pacientes",
                "name": "pacientes",
                "icon": "dental",
                "iconColor": "var(--nf-secondary-color)",
                "listView": {
                    "name": "pacientes",
                    "config": {
                        "idAccessor": "id",
                        "nameAccessor": "nome",
                        "rowClassAccessor": "none"
                    },
                    "columns": [
                        "nome_completo",
                        "data_criacao",
                        "status"
                    ]
                }
            }
        ]
    },
    "edit": {
        "title": "Usuário {name}",
        "toolbar": [ "send", "cancel" ]
    },
    "add": {
        "title": "Novo usuário",
        "toolbar": [ "send", "cancel" ]
    },
    "detail": {
        "title": "Usuário {name}",
        "toolbar": [ "close" ]
    }
}