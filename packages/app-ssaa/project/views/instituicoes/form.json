{
    "$schema": "../../../../../schemas/form.schema.json",
    "comment": "Generated manually",
    "name": "instituicoes",
    "language": "ptBR",
    "layout": {
        "tabs": [
            {
                "label": "Cadastro",
                "name": "cadastro",
                "sections": [
                    {
                        "initialState": "noheader",
                        "columns": [
                            [ "nome", "nome_abreviado" ],
                            [
                                [ "data_criacao", "data_expiracao" ],
                                "cnpj"
                            ]
                        ]
                    }
                ]
            },
            {
                "label": "Usuários",
                "name": "usuarios",
                "listView": {
                    "name": "usuarios",
                    "config": {
                        "header": true,
                        "idAccessor": "id",
                        "nameAccessor": "nome_abreviado",
                        "rowClassAccessor": "none"
                    },
                    "strings": {
                        "singular": "usuário",
                        "plural": "usuários",
                        "therecord": "o usuário"
                    },
                    "columns": [
                        "nome_completo",
                        "nome_abreviado",
                        "data_criacao",
                        "data_expiracao",
                        "status"
                    ],
                    "actions": [ "record_edit", "record_delete" ]
                }
            }
        ]
    },
    "edit": {
        "title": "Instituição {name}",
        "toolbar": [ "send", "cancel" ]
    },
    "add": {
        "title": "Nova instituição",
        "toolbar": [ "send", "cancel" ]
    },
    "detail": {
        "title": "Instituição {name}",
        "toolbar": [ "close" ]
    }
}