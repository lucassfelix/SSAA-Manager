{
    "$schema": "../../../../../schemas/form.schema.json",
    "comment": "Generated manually",
    "name": "instituicoes",
    "language": "ptBR",
    "layout": {
        "tabs": [
            {
                "label": "Cadastro",
                "name": "cadastro",
                "sections": [
                    {
                        "initialState": "noheader",
                        "columns": [
                            [ "nome", "nome_abreviado" ],
                            [
                                [ "data_criacao", "data_expiracao" ],
                                "cnpj"
                            ]
                        ]
                    }
                ]
            },
            {
                "label": "Usuários",
                "name": "usuarios",
                "textColor": "var(--mantine-primary-color-5)",
                "icon": "users",
                "listView": {
                    "name": "usuarios",
                    "config": {
                        "idAccessor": "id",
                        "nameAccessor": "nome_abreviado",
                        "rowClassAccessor": "none"
                    },
                    "columns": [
                        "nome_completo",
                        "nome_abreviado",
                        "data_criacao",
                        "data_expiracao",
                        "status"
                    ]
                }
            },
            {
                "label": "Pacientes",
                "name": "pacientes",
                "textColor": "var(--mantine-primary-color-5)",
                "icon": "dental",
                "listView": {
                    "name": "pacientes",
                    "config": {
                        "idAccessor": "id",
                        "nameAccessor": "nome",
                        "rowClassAccessor": "none"
                    },
                    "columns": [
                        "nome_completo",
                        "data_criacao",
                        "status"
                    ]
                }
            },
            {
                "label": "Projetos",
                "name": "projetos",
                "textColor": "var(--mantine-primary-color-5)",
                "icon": "folderOpen",
                "listView": {
                    "name": "projetos",
                    "config": {
                        "idAccessor": "id",
                        "nameAccessor": "nome",
                        "rowClassAccessor": "none"
                    },
                    "columns": [
                        "nome",
                        "data_criacao",
                        "ultima_edicao",
                        "status"
                    ]
                }
            }
        ]
    },
    "edit": {
        "title": "Instituição {name}",
        "toolbar": [ "send", "cancel" ]
    },
    "add": {
        "title": "Nova instituição",
        "toolbar": [ "send", "cancel" ]
    },
    "detail": {
        "title": "Instituição {name}",
        "toolbar": [ "close" ]
    }
}