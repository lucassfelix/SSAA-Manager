{
    "$schema": "../../../../../schemas/form.schema.json",
    "comment": "Generated manually",
    "name": "instituicoes",
    "language": "ptBR",
    "layout": {
        "sections": [
            {
                "initialState": "noheader",
                "columns": [
                    [ "nome", "nome_abreviado" ],
                    [
                        [ "data_criacao", "data_expiracao" ],
                        "cnpj"
                    ]
                ]
            }
        ]
    },
    "__layout": {
        "tabs": [
            {
                "label": "Cadastro",
                "sections": [
                    {
                        "initialState": "noheader",
                        "columns": [
                            [ "nome", "nome_abreviado" ],
                            [
                                [ "data_criacao", "data_expiracao" ],
                                "cnpj"
                            ]
                        ]
                    }
                ]
            },
            {
                "label": "Usuários",
                "sections": [
                    {
                        "initialState": "noheader",
                        "columns": [
                            {
                                "type": "listView",
                                "name": "usuarios",
                                "config": {
                                    "header": true,
                                    "footer": false,
                                    "idAccessor": "id",
                                    "nameAccessor": "nome_abreviado",
                                    "rowClassAccessor": "none"
                                },
                                "strings": {
                                    "singular": "usuário",
                                    "plural": "usuários",
                                    "therecord": "o usuário"
                                },
                                "columns": [
                                    "nome_abreviado",
                                    "data_criacao",
                                    "data_expiracao",
                                    "status",
                                    "commands"
                                ],
                                "actions": [ "record_edit", "record_delete" ],
                                "toolbar": [
                                    { "type": "title", "text": "Usuários" },
                                    "add"
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "edit": {
        "title": "Instituição {name}",
        "toolbar": [ "send", "cancel" ]
    },
    "add": {
        "title": "Nova instituição",
        "toolbar": [ "send", "cancel" ]
    },
    "detail": {
        "title": "Instituição {name}",
        "toolbar": [ "close" ]
    }
}