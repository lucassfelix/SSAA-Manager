{
	"$schema": "../../../schemas/app.schema.json",
	"version": "0.3.0",
	"language": "pt-br",
	"comments": "SSAA: configuração de projeto",
	"projectId": "ssaa-smile-manager",
	"strings": {
		"appTitle": "{pageName} | SSAA",
		"appVersion": "0.10.0"
	},
	"errorStrings": {
		"noRecordsText": "Sem itens a exibir"
	},
	"errorImages": {
		"noViewType": "fruit_basket",
		"viewMissing": "beach_house",
		"formLayoutMissing": "shipwreck_survivor",
		"formConfigMissing": "octopus",
		"formMissing": "forest"
	},
	"paths": {
		"images": "images/"
	},
	"shell": {
		"header": {
			"fullWidth": true,
			"height": 80,
			"bordered": true,
			"items": [ "collapseToggle", "mainTitle", "spacer", "themeSwitch" ]
		},
		"navbar": {
			"width": 200,
			"collapsible": true,
			"collapsedWidth": 72,
			"bordered": true,
			"icons": true,
			"footer": true,
			"items": [ "mainMenu" ],
			"footerItems": [ "logo" ]
		}
	},
	"menu": {
		"items": {
			"gap": 16,
			"radius": 8,
			"labelSize": "1rem",
			"labelWeight": 400,
			"iconFilled": false,
			"iconSize": 26,
			"iconStroke": 2
		}
	},
	"topControls": {
		"mainTitle": {
			"label": "Aplicação de Exemplo NeoFront"
		},
		"collapseToggle": {
			"rotateIcon": true,
			"tipCollapse": "Fechar a barra lateral",
			"tipExpand": "Abrir a barra lateral"
		},
		"themeSwitch": {
			"type": "iconButton",
			"tipLight": "Mudar para o tema claro",
			"tipDark": "Mudar para o tema escuro"
		},
		"logo": {
			"collapsedHeight": 52,
			"expandedHeight": 52,
			"altText": "Logotipo Hypervisual",
			"link": "/"
		}
	},
	"controls": {
		"userMenu": {
			"type": "iconButton",
			"name": "userSettings",
			"icon": "manage_accounts",
			"action": "openUserSettings",
			"items": [ ]
		},
		"separator": {
			"type": "separator"
		},
		"add": {
			"type": "iconButton",
			"tip": "Adicionar {singular}",
			"icon": "add",
			"action": "add"
		},
		"search": {
			"type": "iconButton",
			"tip": "Pesquisar {plural}",
			"icon": "search",
			"action": "search"
		},
		"send": {
			"type": "textButton",
			"label": "Enviar",
			"action": "send",
			"default": true
		},
		"cancel": {
			"type": "textButton",
			"label": "Cancelar",
			"action": "cancel"
		},
		"listViewMore": {
			"type": "iconButton",
			"tip": "Mais ações",
			"icon": "moreVertical",
			"items": [
				{
					"name": "exportCSV",
					"label": "Exportar para planilha",
					"action": "exportCSV"
				},
				{
					"name": "exportPDF",
					"label": "Exportar PDF",
					"action": "exportPDF"
				},
				{
					"type": "separator"
				},
				{
					"name": "print",
					"label": "Imprimir listagem",
					"action": "printRecords"
				}
			]
		}
	},
	"toolbars": {
		"horizontalPadding": 10,
		"verticalPadding": 6,
		"gap": 16,
		"align": "left",
		"iconButtons": {
			"rotateSelected": true,
			"size": 36,
			"radius": 8,
			"filled": false,
			"iconSize": 24,
			"iconStroke": 2
		},
		"textButtons": {
			"size": "sm",
			"radius": 6,
			"fontSize": "0.8rem",
			"fontWeight": 700,
			"uppercase": true
		},
		"titles": {
			"size": 20,
			"fontWeight": 500,
			"width": 120
		}
	},
	"listViews": {
		"defaultList": "usuarios",
		"defaultPageSize": 10,
		"table": {
			"striped": false,
			"bordered": false,
			"rowBorders": true,
			"colBorders": false,
			"borderRadius": "sm",
			"horizontalSpacing": 10,
			"verticalSpacing": 12,
			"headerHeight": 20,
			"shadow": "xs",
			"wrapperSize": "md",
			"wrapperBooleanWidth": 50,
			"booleanIconsSize": 26,
			"booleanIconsStroke": 1,
			"trueIcon": "circleCheck",
			"falseIcon": "squareX"
		}
	},
	"forms": {
		"fieldSize": "sm",
		"verticalGap": "xl",
		"fullHeight": true,
		"clearSelectionValue": "__clear_selection__",
		"selectionCheck": false,
		"checkboxTopPadding": 36,
		"outlinedSections": false,
		"toolbar": {
			"align": "right",
			"upperBorder": true
		}
	},
	"theme": {
		"defaultUIScale": 100,
		"iconFamily": "tabler",
		"mainFontFamily": "Roboto",
		"headingsFontFamily": "Roboto",
		"lightMode": {
			"expandedLogo": "logo-ssaa-light.svg",
			"collapsedLogo": "logo-ssaa-light.svg"
		},
		"darkMode": {
			"expandedLogo": "logo-ssaa-dark.svg",
			"collapsedLogo": "logo-ssaa-dark.svg"
		}
	}
}