{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@neofront/core": ["../neofront/src/index.ts"],
      "@": ["../neofront/src/components"],
      "context": ["../neofront/src/contexts/index.ts"],
      "project/*": ["./project/*"]
    }
  },
  "include": ["src", "project"],
  "exclude": ["node_modules"]
}
