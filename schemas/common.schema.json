{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://neofront.com.br/schemas/common.schema.json",
  "title": "Common schema",
  "description": "Schema for information used by several schemas.",
  "type": "object",
  "additionalProperties": false,

  // Definitions for reusable components

  "definitions": {
    "$schema": {
      "type": "string",
      "description": "URI reference to the schema that documents this file."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "language": {
      "type": "string",
      "description": "BCP-47 language code used in the localization of this file.",
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$",
      "enum": [ "en-us", "es-419", "pt-br" ]
    },
    "comments": {
      "type": "string",
      "description": "Comments about the automatic generation of this file."
    },
    "formLayout": {
      "type": "object",
      "description": "Layout definition describing header fields and sectioned columns, or a list of tabs.",
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "array",
          "description": "List of field names to render in the header row.",
          "items": {
            "type": "string",
            "description": "Field name to render in the header row."
          }
        },
        "sections": {
          "type": "array",
          "description": "Array of sections that compose the form body.",
          "items": {
            "type": "object",
            "description": "A single section with title, state and columns.",
            "properties": {
              "title": {
                "type": "string",
                "description": "Section title."
              },
              "initialState": {
                "type": "string",
                "enum": [
                  "collapsed",
                  "expanded",
                  "fixed",
                  "noheader"
                ],
                "description": "Initial state of the section (accordion)."
              },
              "columns": {
                "type": "array",
                "description": "Columns for this section; each column is an array of field names or row arrays.",
                "items": {
                  "type": "array",
                  "description": "A single column containing field names or row arrays.",
                  "items": {
                    "description": "Field names or rows of field names.",
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "Field name used in this column."
                      },
                      {
                        "type": "array",
                        "description": "Row of field names rendered side by side.",
                        "items": {
                          "type": "string",
                          "description": "Field name in the row."
                        }
                      }
                    ]
                  }
                }
              }
            },
            "required": [
              "columns"
            ],
            "additionalProperties": false
          }
        },
        "tabs": {
          "type": "array",
          "description": "Array of tabs, each containing a label and either sections/header or a listView.",
          "items": {
            "type": "object",
            "description": "A single tab definition.",
            "properties": {
              "label": {
                "type": "string",
                "description": "Tab label displayed in the tab bar."
              },
              "name": {
                "type": "string",
                "description": "Logical name of the tab."
              },
              "textColor": {
                "type": "string",
                "description": "Optional text color for the tab label."
              },
              "icon": {
                "type": "string",
                "description": "Optional name of icon to display in the tab."
              },
              "iconColor": {
                "type": "string",
                "description": "Optional color for the tab icon."
              },
              "header": {
                "type": "array",
                "description": "List of field names to render in the header row of this tab.",
                "items": {
                  "type": "string",
                  "description": "Field name to render in the header row."
                }
              },
              "sections": {
                "type": "array",
                "description": "Array of sections for this tab.",
                "items": {
                  "$ref": "#/definitions/formLayout/properties/sections/items"
                }
              },
              "listView": {
                "$ref": "#/definitions/listView",
                "description": "Embedded listView to display in this tab."
              }
            },
            "required": [ "label" ],
            "additionalProperties": false
          }
        }
      }
    },
    "toolbarItem": {
      "type": [ "object", "string" ],
      "description": "A single toolbar item. May be a string (logical name) or an object defining the item.",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [ "text", "title", "iconButton", "textButton", "separator", "spacer" ],
          "description": "Type of toolbar item."
        },
        "name": {
          "type": "string",
          "description": "Logical name for the item."
        },
        "text": {
          "type": "string",
          "description": "Text content (for 'text' and 'title' types)."
        },
        "label": {
          "type": "string",
          "description": "Button label (for 'textButton' type)."
        },
        "icon": {
          "type": "string",
          "description": "Icon name (for 'iconButton' type)."
        },
        "tip": {
          "type": "string",
          "description": "Tooltip text."
        },
        "selectedTip": {
          "type": "string",
          "description": "Tooltip text when toggle is selected."
        },
        "toggle": {
          "type": "boolean",
          "description": "Whether this is a toggle button."
        },
        "action": {
          "type": "string",
          "description": "Named action to invoke on click."
        },
        "items": {
          "type": "array",
          "description": "Submenu items for dropdown buttons.",
          "items": {
            "$ref": "#/definitions/menuItem"
          }
        }
      }
    },
    "menuItem": {
      "type": "object",
      "description": "A menu item in a dropdown.",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [ "separator" ],
          "description": "Menu item type (optional, used for separators)."
        },
        "name": {
          "type": "string",
          "description": "Logical name for the menu item."
        },
        "label": {
          "type": "string",
          "description": "Display label."
        },
        "action": {
          "type": "string",
          "description": "Named action to invoke on click."
        }
      }
    },
    "listView": {
      "description": "Configuration schema for listviews.",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "$ref": "#/definitions/$schema"
        },
        "comment": {
          "type": "string",
          "description": "Free-form comment about this file."
        },
        "language": {
          "type": "string",
          "description": "Locale code used in this file (e.g. 'ptBR', 'enUS')."
        },
        "type": {
          "type": "string",
          "enum": [ "listView" ],
          "description": "Type of view (must be 'listView')."
        },
        "name": {
          "type": "string",
          "description": "Logical name of the listview."
        },
        "config": {
          "type": "object",
          "description": "Configuration options for the listview.",
          "additionalProperties": false,
          "properties": {
            "header": {
              "type": "boolean",
              "description": "Whether to show the table header."
            },
            "footer": {
              "type": "boolean",
              "description": "Whether to show the table footer."
            },
            "idAccessor": {
              "type": "string",
              "description": "Path to the unique identifier field in each record."
            },
            "nameAccessor": {
              "type": "string",
              "description": "Path to the display name field in each record."
            },
            "rowClassAccessor": {
              "type": "string",
              "description": "Path to a field used to determine row CSS class."
            }
          }
        },
        "columns": {
          "type": "array",
          "description": "List of column names to display (references fields).",
          "items": {
            "type": "string",
            "description": "Field name to display as a column."
          }
        },
        "actions": {
          "type": "array",
          "description": "List of record actions available (e.g. record_detail, record_edit, record_delete).",
          "items": {
            "type": "string",
            "description": "Action name.",
            "enum": [ "record_detail", "record_edit", "record_delete" ]
          }
        },
        "toolbar": {
          "description": "Toolbar configuration for the listview.",
          "items": {
            "$ref": "./common.schema.json#/definitions/toolbarItem"
          }
        },
        "filterPanel": {
          "type": "object",
          "description": "Filter panel configuration.",
          "properties": {
            "layout": {
              "$ref": "./common.schema.json#/definitions/formLayout"
            },
            "toolbar": {
              "type": "array",
              "description": "Toolbar items for the filter panel.",
              "items": {
                "type": "string",
                "description": "A toolbar item name."
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [ "name", "config", "columns" ]
    }
  }
}