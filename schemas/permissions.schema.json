{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://neofront.com.br/schemas/permissions.schema.json",
  "title": "Permissions configuration schema",
  "description": "Schema for permissions configuration (project/permissions.json).",
  "type": "object",
  "additionalProperties": false,

  "definitions": {
    "predicateValue": {
      "description": "Value used in a predicate.",
      "type": ["string", "number", "boolean", "null"]
    },

    "predicateObject": {
      "description": "Predicate object form.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "description": "Left-hand field path to evaluate (e.g. 'clinica_id')." },
        "op": { "type": "string", "description": "Comparison operator (e.g. '==', '!=', '<=', etc)." },
        "value": { "$ref": "#/definitions/predicateValue" }
      },
      "required": ["field", "op", "value"]
    },

    "predicate": {
      "description": "Predicate expression. Supports: 'all', 'none', a shorthand string (e.g. 'clinica_id == $user.clinica_id') or an object {field, op, value}.",
      "anyOf": [
        { "const": "all", "description": "Allow all records." },
        { "const": "none", "description": "Deny all records." },
        { "type": "string", "description": "Shorthand predicate string. Must be space-separated (left op right)." },
        { "$ref": "#/definitions/predicateObject" }
      ]
    },

    "fieldFilter": {
      "description": "Filter applied to select options or other datasets.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": { "type": "string", "description": "Comparison operator (e.g. '==', '<=', etc)." },
        "value": { "$ref": "#/definitions/predicateValue" }
      },
      "required": ["op", "value"]
    },

    "fieldRule": {
      "description": "Field rule used mostly by forms. Either a shorthand predicate string, or an object with readOnly/visible/filter.",
      "anyOf": [
        { "type": "string", "description": "Shorthand predicate string (space-separated)." },
        {
          "type": "object",
          "description": "Object-form field rule.",
          "additionalProperties": false,
          "properties": {
            "readOnly": { "type": "boolean", "description": "Whether the field is read-only in forms." },
            "visible": { "type": "boolean", "description": "Whether the field is visible in forms." },
            "filter": { "$ref": "#/definitions/fieldFilter" }
          }
        }
      ]
    },

    "viewRules": {
      "description": "Operation-level permissions for a given view.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browse": { "type": "boolean", "description": "Allows listing/browsing the view." },
        "detail": { "type": "boolean", "description": "Allows navigating to the detail screen." },
        "edit": {
          "description": "Allows editing. Can be boolean or a predicate.",
          "anyOf": [
            { "type": "boolean", "description": "Boolean allow/deny." },
            { "$ref": "#/definitions/predicate" }
          ]
        },
        "add": {
          "description": "Allows adding. Can be boolean or a predicate.",
          "anyOf": [
            { "type": "boolean", "description": "Boolean allow/deny." },
            { "$ref": "#/definitions/predicate" }
          ]
        },
        "delete": {
          "description": "Allows deleting. Can be boolean or a predicate.",
          "anyOf": [
            { "type": "boolean", "description": "Boolean allow/deny." },
            { "$ref": "#/definitions/predicate" }
          ]
        }
      }
    },

    "viewPermissions": {
      "description": "Permissions for a single view within a role.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": { "$ref": "#/definitions/viewRules" },
        "scope": { "$ref": "#/definitions/predicate" },
        "tabs": {
          "type": "object",
          "description": "Optional tab visibility overrides (tabName -> boolean).",
          "additionalProperties": { "type": "boolean", "description": "Whether the named tab is enabled/visible." }
        },
        "fields": {
          "type": "object",
          "description": "Field-level rules used mostly by forms.",
          "additionalProperties": { "$ref": "#/definitions/fieldRule" }
        }
      }
    },

    "rolePermissions": {
      "description": "Permissions for a single role.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "description": "Numeric role identifier stored in the user record (roleAccessor)." },
        "scope": { "$ref": "#/definitions/predicate" },
        "views": {
          "type": "object",
          "description": "Per-view permissions keyed by view name.",
          "additionalProperties": { "$ref": "#/definitions/viewPermissions" }
        }
      },
      "required": ["value", "views"]
    }
  },

  "properties": {
    "$schema": {
      "$ref": "./common.schema.json#/definitions/$schema"
    },
    "comment": {
      "type": "string",
      "description": "Optional comment/notes about this file."
    },
    "userTable": {
      "type": "string",
      "description": "Name of the table/view that contains users (e.g. 'usuarios')."
    },
    "idAccessor": {
      "type": "string",
      "description": "User id field name. Defaults to 'id'."
    },
    "usernameAccessor": {
      "type": "string",
      "description": "User login field name. Defaults to 'username'."
    },
    "nameAccessor": {
      "type": "string",
      "description": "User display name field name."
    },
    "roleAccessor": {
      "type": "string",
      "description": "Field that contains the role value (e.g. 'tipo_permissao')."
    },
    "roles": {
      "type": "object",
      "description": "Role definitions keyed by role name.",
      "additionalProperties": { "$ref": "#/definitions/rolePermissions" }
    }
  },

  "required": [
    "userTable",
    "roleAccessor",
    "roles"
  ]
}
