{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://neofront.com.br/schemas/fields.schema.json",
  "title": "Fields metadata schema",
  "description": "Schema for unified field definitions (project/views/*/fields.json).",
  "type": "object",
  "additionalProperties": false,

  // Top-level properties

  "properties": {
    "$schema": {
      "$ref": "./common.schema.json#/definitions/$schema"
    },
    "_$schema": {
      "type": "string",
      "description": "Disabled schema reference (prefixed with underscore)."
    },
    "comment": {
      "type": "string",
      "description": "Free-form comment about this file."
    },
    "name": {
      "type": "string",
      "description": "Logical name of the view (e.g. 'usuarios', 'empresas')."
    },
    "language": {
      "type": "string",
      "description": "Locale code used in this file (e.g. 'ptBR', 'enUS')."
    },
    "strings": {
      "type": "object",
      "description": "Localized strings for this view.",
      "additionalProperties": false,
      "properties": {
        "singular": {
          "type": "string",
          "description": "Singular form of the entity name."
        },
        "plural": {
          "type": "string",
          "description": "Plural form of the entity name."
        },
        "theItem": {
          "type": "string",
          "description": "Phrase used to refer to a single record (e.g. 'the user')."
        }
      },
      "required": [ "singular", "plural", "theItem" ]
    },
    "fields": {
      "type": "object",
      "description": "Field definitions keyed by field name.",
      "additionalProperties": {
        "$ref": "./common.schema.json#/definitions/field"
      }
    }
  },

  // Required properties

  "required": [
    "name",
    "strings",
    "fields"
  ]
}