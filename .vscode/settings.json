{
	"[typescript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"typescript.formatter.enable": true,
	"eslint.useFlatConfig": true,
	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact"
	],
	// "eslint.format.enable": true,
	"eslint.enable": true,
	"eslint.run": "onType",
	"eslint.workingDirectories": [
		{
			"mode": "auto"
		}
	]
}